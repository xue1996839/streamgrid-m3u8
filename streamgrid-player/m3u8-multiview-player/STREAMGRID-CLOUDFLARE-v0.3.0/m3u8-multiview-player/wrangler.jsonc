{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "streamgrid-m3u8",
  "main": "./worker.js",
  "compatibility_date": "2026-11-14",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/receiver",
      "/receiver/"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSIONS",
        "class_name": "SessionRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "SessionRoom"
      ]
    }
  ]
}
